{
  "buildCommand": "cd Portfolio-Website && npm install && npm run build",
  "outputDirectory": "Portfolio-Website/dist",
  "installCommand": "cd Portfolio-Website && npm install",
  "public": "Portfolio-Website/public",
  "rewrites": [
    {
      "source": "/:path((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
